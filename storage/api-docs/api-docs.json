{
    "openapi": "3.0.0",
    "info": {
        "title": "Laravel API Documentation",
        "description": "Документация API",
        "version": "1.0.0"
    },
    "paths": {
        "/api/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Регистрация пользователя",
                "operationId": "c47411f6de96b5b30018c647e449e470",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "test@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Пользователь зарегистрирован"
                    }
                }
            }
        },
        "/api/verify-registration-code": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Подтверждение кода регистрации",
                "operationId": "96103b8774eb7c34a6652bc8340fb33b",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "code"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "test@example.com"
                                    },
                                    "code": {
                                        "type": "string",
                                        "example": "1234"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Код подтверждён"
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Авторизация",
                "operationId": "82d74137970376a374510566964c9813",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "test@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Успешная авторизация"
                    },
                    "401": {
                        "description": "Неверные данные или аккаунт деактивирован"
                    },
                    "403": {
                        "description": "Аккаунт не подтверждён (email не подтверждён)"
                    }
                }
            }
        },
        "/v1/forgot-password": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Запрос кода восстановления пароля",
                "description": "Код отправляется только подтверждённому и не удалённому аккаунту. Ответ одинаков для любого email.",
                "operationId": "9d75b8d9a1771fa9588f9b46fc5c5cf3",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "test@example.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Запрос принят"
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    },
                    "429": {
                        "description": "Слишком частые запросы (не чаще одного в минуту для email)"
                    }
                }
            }
        },
        "/v1/reset-password": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Установка нового пароля по коду",
                "description": "Код действует 10 минут. После смены пароля все сессии и токены пользователя завершаются.",
                "operationId": "3900632a0e8b776a145bee67e1947ccf",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "code",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "test@example.com"
                                    },
                                    "code": {
                                        "type": "string",
                                        "example": "123456"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "new-password"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "example": "new-password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Пароль изменён"
                    },
                    "400": {
                        "description": "Неверный или просроченный код"
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    },
                    "429": {
                        "description": "Слишком много попыток"
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Выход из системы",
                "operationId": "e745d5ecdeb4a520f8a98daed4d4bfd7",
                "responses": {
                    "200": {
                        "description": "Выход выполнен"
                    },
                    "401": {
                        "description": "Не авторизован"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/user": {
            "get": {
                "tags": [
                    "User"
                ],
                "summary": "Получить текущего пользователя",
                "operationId": "b8e438773a13bec344011b140c909411",
                "responses": {
                    "200": {
                        "description": "Успешный ответ",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "username": {
                                                    "type": "string",
                                                    "example": "john_doe"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "john@example.com"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не авторизован"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/v1/user/password": {
            "put": {
                "tags": [
                    "User"
                ],
                "summary": "Сменить пароль текущего пользователя",
                "description": "Проверяет текущий пароль и сохраняет новый. Пользователь остаётся в системе, его сессии на других устройствах и Sanctum-токены удаляются. Лимит: 5 запросов в минуту и 20 в час.",
                "operationId": "b273955f8a6cdc06abfd4407aacf211f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "current_password",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "current_password": {
                                        "type": "string",
                                        "example": "password123"
                                    },
                                    "password": {
                                        "description": "Минимум 8 символов, должен отличаться от текущего",
                                        "type": "string",
                                        "example": "newPassword123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "example": "newPassword123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Пароль изменён",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "statusCode": {
                                            "type": "integer",
                                            "example": 200
                                        },
                                        "data": {
                                            "properties": {
                                                "message": {
                                                    "type": "string",
                                                    "example": "Пароль изменён"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не авторизован"
                    },
                    "422": {
                        "description": "Ошибка валидации: неверный текущий пароль, пароли не совпадают, новый пароль короче 8 символов или совпадает с текущим",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "statusCode": {
                                            "type": "integer",
                                            "example": 422
                                        },
                                        "data": {
                                            "properties": {
                                                "message": {
                                                    "type": "string",
                                                    "example": "Неверный текущий пароль"
                                                },
                                                "errors": {
                                                    "type": "object",
                                                    "example": {
                                                        "current_password": [
                                                            "Неверный текущий пароль"
                                                        ]
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Слишком много запросов"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/v1/user": {
            "delete": {
                "tags": [
                    "User"
                ],
                "summary": "Удалить аккаунт текущего пользователя",
                "description": "Деактивирует аккаунт (проставляет deactivated_at), удаляет вишлисты пользователя и их позиции, завершает все его сессии. Войти в деактивированный аккаунт нельзя.",
                "operationId": "461dc63a1194a0e23e4491704ba5cd6a",
                "responses": {
                    "200": {
                        "description": "Аккаунт удалён",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "statusCode": {
                                            "type": "integer",
                                            "example": 200
                                        },
                                        "data": {
                                            "properties": {
                                                "message": {
                                                    "type": "string",
                                                    "example": "Аккаунт удалён"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не авторизован"
                    },
                    "429": {
                        "description": "Слишком много запросов"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/v1/wishlists": {
            "get": {
                "tags": [
                    "Wishlists"
                ],
                "summary": "Получить списки желаний пользователя",
                "operationId": "eb58ca4ba94488a41c1d0b01d61ad0cd",
                "responses": {
                    "200": {
                        "description": "Успешный ответ",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "title": {
                                                        "type": "string",
                                                        "example": "День рождения"
                                                    },
                                                    "color": {
                                                        "description": "Ключ цвета фона списка",
                                                        "type": "string",
                                                        "example": "lavender",
                                                        "enum": [
                                                            "white",
                                                            "lavender",
                                                            "pink",
                                                            "peach",
                                                            "lemon",
                                                            "mint",
                                                            "sky"
                                                        ]
                                                    },
                                                    "createdAt": {
                                                        "description": "Дата создания списка (ISO 8601)",
                                                        "type": "string",
                                                        "format": "date-time",
                                                        "example": "2026-09-12T14:30:00+00:00"
                                                    },
                                                    "hideSelections": {
                                                        "description": "Режим сюрприза: если true, у позиций нет поля isSelected",
                                                        "type": "boolean",
                                                        "example": false
                                                    },
                                                    "items": {
                                                        "type": "array",
                                                        "items": {
                                                            "properties": {
                                                                "id": {
                                                                    "type": "integer",
                                                                    "example": 10
                                                                },
                                                                "label": {
                                                                    "type": "string",
                                                                    "example": "Книга «Мастер и Маргарита»"
                                                                },
                                                                "url": {
                                                                    "description": "Ссылка на товар (http или https), необязательна",
                                                                    "type": "string",
                                                                    "format": "uri",
                                                                    "example": "https://example.com/books/master-i-margarita",
                                                                    "nullable": true,
                                                                    "maxLength": 2048
                                                                },
                                                                "isSelected": {
                                                                    "description": "Отсутствует, если включён режим сюрприза (hideSelections)",
                                                                    "type": "boolean",
                                                                    "example": false
                                                                }
                                                            },
                                                            "type": "object"
                                                        }
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не авторизован"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Wishlists"
                ],
                "summary": "Создать список желаний",
                "operationId": "1c9270c3b553e8e37291e12e66fa7413",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "title",
                                    "items"
                                ],
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "День рождения 2"
                                    },
                                    "color": {
                                        "description": "Ключ цвета фона списка. Необязателен, по умолчанию white",
                                        "type": "string",
                                        "example": "mint",
                                        "enum": [
                                            "white",
                                            "lavender",
                                            "pink",
                                            "peach",
                                            "lemon",
                                            "mint",
                                            "sky"
                                        ]
                                    },
                                    "hideSelections": {
                                        "description": "Режим сюрприза: скрывать от владельца, какие позиции выбрали гости. Необязателен, по умолчанию false",
                                        "type": "boolean",
                                        "example": false
                                    },
                                    "items": {
                                        "type": "array",
                                        "items": {
                                            "properties": {
                                                "label": {
                                                    "type": "string",
                                                    "example": "Книга «Мастер и Маргарита»"
                                                },
                                                "url": {
                                                    "description": "Ссылка на товар (http или https), необязательна",
                                                    "type": "string",
                                                    "format": "uri",
                                                    "example": "https://example.com/books/master-i-margarita",
                                                    "nullable": true,
                                                    "maxLength": 2048
                                                }
                                            },
                                            "type": "object"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Список успешно создан",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "title": {
                                                    "type": "string",
                                                    "example": "День рождения 2"
                                                },
                                                "color": {
                                                    "description": "Ключ цвета фона списка",
                                                    "type": "string",
                                                    "example": "mint",
                                                    "enum": [
                                                        "white",
                                                        "lavender",
                                                        "pink",
                                                        "peach",
                                                        "lemon",
                                                        "mint",
                                                        "sky"
                                                    ]
                                                },
                                                "createdAt": {
                                                    "description": "Дата создания списка (ISO 8601)",
                                                    "type": "string",
                                                    "format": "date-time",
                                                    "example": "2026-09-12T14:30:00+00:00"
                                                },
                                                "hideSelections": {
                                                    "description": "Режим сюрприза: если true, у позиций нет поля isSelected",
                                                    "type": "boolean",
                                                    "example": false
                                                },
                                                "items": {
                                                    "type": "array",
                                                    "items": {
                                                        "properties": {
                                                            "id": {
                                                                "type": "integer",
                                                                "example": 1
                                                            },
                                                            "label": {
                                                                "type": "string",
                                                                "example": "Свеча с ароматом ванили"
                                                            },
                                                            "url": {
                                                                "description": "Ссылка на товар (http или https), необязательна",
                                                                "type": "string",
                                                                "format": "uri",
                                                                "example": "https://example.com/books/master-i-margarita",
                                                                "nullable": true,
                                                                "maxLength": 2048
                                                            },
                                                            "isSelected": {
                                                                "description": "Отсутствует, если включён режим сюрприза (hideSelections)",
                                                                "type": "boolean",
                                                                "example": false
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    },
                    "401": {
                        "description": "Не авторизован"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "tags": [
        {
            "name": "Wishlists",
            "description": "Работа со списками желаний"
        },
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "User",
            "description": "User"
        }
    ]
}